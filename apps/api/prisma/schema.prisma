generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  avatarUrl String?
  createdAt DateTime  @default(now())

  assignedTickets Ticket[]  @relation("AssigneeRelation")
  comments        Comment[]

  @@map("users")
}

model Ticket {
  id          String       @id @default(cuid())
  title       String
  description String       @default("") @db.Text
  status      TicketStatus @default(BACKLOG)
  priority    Priority     @default(MEDIUM)
  teamTag     String?
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  assigneeId     String?
  assignee       User?    @relation("AssigneeRelation", fields: [assigneeId], references: [id], onDelete: SetNull)

  parentTicketId String?
  parentTicket   Ticket?  @relation("TicketHierarchy", fields: [parentTicketId], references: [id], onDelete: SetNull)
  children       Ticket[] @relation("TicketHierarchy")

  comments Comment[]

  @@index([status])
  @@index([priority])
  @@index([assigneeId])
  @@index([teamTag])
  @@index([parentTicketId])
  @@index([sortOrder])
  @@map("tickets")
}

model Comment {
  id        String   @id @default(cuid())
  message   String   @db.Text
  createdAt DateTime @default(now())

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("comments")
}

enum TicketStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
